# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STORYTAILOR_SECRET_KEY=change-me-to-a-long-random-string
STORYTAILOR_DATABASE=instance/storytailor.sqlite
STORYTAILOR_RETENTION_DAYS=400
# "openai" or "offline" (deterministic local generator, no network)
STORYTAILOR_LLM_PROVIDER=openai
STORYTAILOR_LEVEL_TOLERANCE=150
ALLOWED_ORIGINS=http://localhost:5173
